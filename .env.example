# zarishnoksha development environment
# Copy this file to .env and fill in the keys you need.
# All keys are OPTIONAL — core development and most tests work without them.

# --- LLM-backed test suites (skip cleanly if unset) ---

# Used by: tests/skill-behavior (Claude Sonnet 4.6), tests/live-e2e (Claude Haiku 4.5)
# ANTHROPIC_API_KEY=sk-ant-...

# Used by: tests/skill-behavior (GPT-5.5)
# OPENAI_API_KEY=sk-...

# Used by: tests/skill-behavior (Gemini 3.1 Flash Lite)
# GOOGLE_GENERATIVE_AI_API_KEY=...
# GOOGLE_CLOUD_API_KEY=...            # alias, auto-mirrored by test harness

# Used by: tests/live-e2e DeepSeek fallback, tests/live-svelte-adapter-deepseek
# DEEPSEEK_API_KEY=sk-...

# --- Optional runtime features ---

# Used by: live-mode copy-edit agent (subprocess claude CLI auth)
# CLAUDE_CODE_OAUTH_TOKEN=...

# --- Cloudflare Pages deploy (CLOUDFLARE_PAGES_DEPLOY workflow / `bun run deploy`) ---
# Create a token with "Cloudflare Pages: Edit" permission (or Account.Cloudflare Pages: Edit).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# --- Live-mode / E2E test tuning (all OPTIONAL; defaults in code) ---

# Scope live-E2E to a single fixture (also set zarishnoksha_E2E_SCENARIOS=core while iterating)
# zarishnoksha_E2E_ONLY=astro-vite7

# Dump page-DOM + dev-server-log on live-E2E failure
# zarishnoksha_E2E_DEBUG=1

# Swap the deterministic fake live-E2E agent for an API-backed one ('llm')
# zarishnoksha_E2E_AGENT=llm

# Force a live-E2E LLM provider ('anthropic' | 'deepseek') or override the model
# zarishnoksha_E2E_LLM_PROVIDER=anthropic
# zarishnoksha_E2E_LLM_MODEL=

# Scope the skill-behavior suite to one provider id, or dump per-scenario traces
# zarishnoksha_SKILL_BEHAVIOR_MODELS=
# zarishnoksha_SKILL_BEHAVIOR_VERBOSE=1

# Log the live-mode hook to a file for debugging
# zarishnoksha_HOOK_LOG=/tmp/zarishnoksha-hook.log

# Suppress the initial update check (useful in offline/CI environments)
# zarishnoksha_NO_UPDATE_CHECK=1
